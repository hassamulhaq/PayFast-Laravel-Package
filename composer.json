{
    "name": "hassam/payfast-laravel-package",
    "description": "Drop-in Laravel integration for PayFast Pakistan (gopayfast.com) — hosted checkout, signed external-storefront handoff (Wix/Shopify/custom), IPN + redirect callback handling, customer auto-create, receipts, and webhook notify-back.",
    "keywords": [
        "laravel",
        "payfast",
        "gopayfast",
        "pakistan",
        "payments",
        "wix",
        "shopify",
        "ecommerce"
    ],
    "homepage": "https://github.com/hassam/payfast-laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "hassamulhaq",
            "email": "developer.hassam@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3||^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/database": "^11.0||^12.0||^13.0",
        "illuminate/http": "^11.0||^12.0||^13.0",
        "illuminate/mail": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Required only if you set PAYFAST_AUTO_ASSIGN_ROLE to auto-attach a role to newly created customers.",
        "owen-it/laravel-auditing": "If you want per-row audit history on the PaymentTransaction model. Extend the model and add the Auditable trait.",
        "spatie/laravel-activitylog": "If you want narrow event logs (e.g. status transitions) on PaymentTransaction."
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Payfastlaravelpackage\\PayFastLaravelPackage\\": "src/",
            "Payfastlaravelpackage\\PayFastLaravelPackage\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payfastlaravelpackage\\PayFastLaravelPackage\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Payfastlaravelpackage\\PayFastLaravelPackage\\PayFastLaravelPackageServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
